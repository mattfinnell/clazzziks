# CLAZZZIKS frontend configuration. Copy to `.env.local` and fill in.
# Without these the app runs in "open mode" (no login) — matching a backend
# that has no Firebase credentials configured.

# Firebase web app config (Project settings > General > Your apps > SDK config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the API base (defaults to /api, proxied to the backend).
# VITE_API_BASE=/api
