# CLAZZZIKS backend configuration. Copy to `.env` (or export in your shell)
# and fill in. Auth is ENFORCED only when a Firebase credential is set below;
# with nothing set the API stays open (anonymous) for local dev.

# --- Firebase token verification -------------------------------------------
# Path to a Firebase service-account JSON (Project settings > Service accounts).
CLAZZZIKS_FIREBASE_CREDENTIALS=./firebase-service-account.json
# Optional: project id (needed when using application-default credentials).
# CLAZZZIKS_FIREBASE_PROJECT_ID=your-project-id
# Force auth off even if creds are present (tests/local only).
# CLAZZZIKS_AUTH_DISABLED=0

# --- Access control --------------------------------------------------------
# Comma-separated allowlist. When set, only these emails may use /api/download;
# everyone else gets 403 "Access pending approval". Leave unset to allow any
# signed-in user.
# CLAZZZIKS_ALLOWED_EMAILS=you@example.com,friend@example.com
