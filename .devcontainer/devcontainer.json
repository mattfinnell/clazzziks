{
  "name": "clazzziks",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/clazzziks",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers-extra/features/pulumi:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {}
  },
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "containerEnv": {
    "AWS_REGION": "us-west-2",
    "AWS_DEFAULT_REGION": "us-west-2",
    "PULUMI_HOME": "/home/vscode/.pulumi-home"
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh-localhost,type=bind,readonly",
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind",
    "source=${localEnv:HOME}/.pulumi,target=/home/vscode/.pulumi-home,type=bind",
    "source=${localEnv:HOME}/.devcontainer-tmp,target=/workspaces/clazzziks/.config-host,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/workspaces/clazzziks/.claude,type=bind",
    "source=${localEnv:HOME}/.zshrc,target=/home/vscode/.zshrc-host,type=bind,readonly",
    "source=${localEnv:HOME}/.oh-my-zsh,target=/home/vscode/.oh-my-zsh-host,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.pylint",
        "Anthropic.claude-code",
        "sukumo28.wav-preview",
        "oderwat.indent-rainbow",
        "aaron-bond.better-comments",
        "usernamehw.errorlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "indentRainbow.indicatorStyle": "light",
        "indentRainbow.lightIndicatorStyleLineWidth": 1,
        "indentRainbow.colors": [
          "rgba(255,255,64,0.2)",
          "rgba(127,255,127,0.2)",
          "rgba(255,127,255,0.2)",
          "rgba(79,236,236,0.2)"
        ]
      }
    }
  },
  "forwardPorts": [5173, 5000, 5432],
  "portsAttributes": {
    "5173": { "label": "Vite dev server" },
    "5000": { "label": "FastAPI backend" },
    "5432": { "label": "Postgres" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
