# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Node / frontend / infra (TypeScript) ────────────────────────────
node_modules/
.pnpm-store/
.vite/
*.tsbuildinfo
coverage/
.eslintcache
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# ── Pulumi local state (cloud state lives in the configured backend) ─
.pulumi/

# ── Downloaded audio output (artifacts, not source) ─────────────────
*.mp3
*.wav
*.flac
*.m4a
*.opus
*.webm
clazzziks_bundle*.zip
out/
downloads/

# Persistent track output directory — keep the dir, ignore audio content
backend/tracks/*
!backend/tracks/.gitkeep

# ── SQLite store (cache / VIP group / rate-limit log) — local state ─
*.db
*.db-wal
*.db-shm

# ── Env / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example

# Firebase service-account credentials (never commit)
firebase-service-account*.json
*serviceAccount*.json

# Cloud credentials (never commit)
.creds

# ── Editor / OS ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.orig
*.rej
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────
*.log

# ── Local tooling / machine-specific (this devcontainer) ─────────────
.claude/
.config-host/
.ssh-localhost/

# ── Custom ───────────────────────────────────────────────────────────
.notes
