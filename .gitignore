# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Downloaded audio output (artifacts, not source)
*.mp3
*.wav
*.flac
*.m4a
*.opus
*.webm
clazzziks_bundle*.zip
out/
downloads/

# Persistent track output directory — keep the dir, ignore audio content
backend/tracks/*
!backend/tracks/.gitkeep

# Node / frontend
.pnpm-store/
**/node_modules/
**/frontend/dist/
**/frontend/.vite/
**/npm-debug.log*
**/yarn-error.log*
**/*.local

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
!.env.example
!**/.env.example

# Firebase service-account credentials (never commit)
firebase-service-account*.json
*serviceAccount*.json

# SQLite store (cache / VIP group / rate-limit log) — local state, not source
*.db
*.db-wal
*.db-shm

# Local tooling / machine-specific
.claude/
.config-host/
.ssh-localhost/
.notes
